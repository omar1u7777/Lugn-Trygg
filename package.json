{
  "name": "lugn-trygg-webapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "serve": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest",
    "test:ci": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vitest run --reporter=json --outputFile=.vitest-results.json --silent",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test visual-regression.spec.ts --project=visual-regression",
    "test:visual:update": "node scripts/update-visual-baselines.js",
    "playwright:install": "playwright install",
    "type-check": "tsc -b --noEmit",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "images:compress": "node scripts/compress-images.mjs",
    "validate-translations": "node scripts/validateTranslations.cjs"
  },
  "dependencies": {
    "@babel/plugin-transform-modules-systemjs": "^7.25.4",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "core-js": "^3.47.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "esbuild": "^0.28.1",
    "firebase": "^12.16.0",
    "framer-motion": "^10.16.16",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.15.0",
    "regenerator-runtime": "^0.14.1",
    "tailwind-merge": "^3.4.0",
    "web-vitals": "^3.5.0",
    "whatwg-fetch": "^3.6.20",
    "zod": "^4.3.6"
  },
  "//engines": "Declares the floor, not a ceiling: local development runs newer Node than production and that is fine. What matters is that CI builds on the SAME version Vercel does — CI ran 20 while Vercel built on 22.x, so a build could pass every check and still differ in production. .nvmrc and .github/workflows/frontend-ci.yml both pin 22 to match Vercel; change them together.",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/forms": "^0.5.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.1",
    "@types/node": "^20.10.4",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.11.13",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^23.0.1",
    "lighthouse": "^13.4.1",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^7.0.1",
    "serve-handler": "^6.1.6",
    "sharp": "^0.35.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^0.19.8",
    "vitest": "^4.0.18",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "undici": "^7.21.0",
    "vite-plugin-pwa": {
      "vite": "^7.3.1"
    },
    "@babel/*": "^7.25.2",
    "@opentelemetry/core": "^2.8.0",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.4",
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "^5.0.8"
    },
    "glob": {
      "brace-expansion": "^5.0.8"
    }
  }
}
