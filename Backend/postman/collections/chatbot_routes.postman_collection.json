{
  "info": {
    "name": "Lugn & Trygg - Chatbot Routes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "d4a1e6c8-2b7f-4a3d-9e5c-7f1b2c8d4a90",
    "description": "Live E2E audit collection for Backend/src/routes/chatbot_routes.py (11 routes). Covers /chat, /message, /chat/stream, /session/close, /history, /analyze-patterns, /exercise, /exercise/<user_id>/<exercise_id>/complete, /analysis/framework, /analysis/progress, /analysis/quality. Uses a dedicated e2e test account and only ever sends neutral, non-crisis mood/chat text."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://lugn-trygg-backend.onrender.com",
      "description": "Base URL (overridable via --env-var base_url=...)"
    },
    {
      "key": "accessToken",
      "value": "",
      "description": "JWT access token (auto-set after login)"
    },
    {
      "key": "userId",
      "value": "",
      "description": "User ID (auto-set after login)"
    },
    {
      "key": "otherUserId",
      "value": "e2e-other-user-not-me-000000000000",
      "description": "A user id that is deliberately NOT the logged-in user, for 403 ownership checks"
    },
    {
      "key": "testEmail",
      "value": "",
      "description": "Dynamic test email (auto-set per run)"
    },
    {
      "key": "testPassword",
      "value": "AuditP@ss2026x!",
      "description": "Password meeting complexity rules (8+ chars, mixed case, digit, symbol)"
    },
    {
      "key": "testUuid",
      "value": "",
      "description": "Unique suffix for this run's test email"
    },
    {
      "key": "exerciseId",
      "value": "",
      "description": "Exercise id captured from POST /exercise, used to chain the /complete call"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate a unique suffix for this run if not already set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-chatbot_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Chatbot Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  const data = body.data || body;",
                  "  if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id);",
                  "  pm.collectionVariables.set('testEmail', 'e2e-chatbot_routes-' + pm.collectionVariables.get('testUuid') + '@test.lugntrygg.se');",
                  "  console.log('Registered new chatbot_routes test user: ' + pm.collectionVariables.get('testEmail'));",
                  "} else if (status === 409) {",
                  "  pm.collectionVariables.set('testEmail', 'e2e-chatbot_routes-' + pm.collectionVariables.get('testUuid') + '@test.lugntrygg.se');",
                  "  console.log('User already existed (unlikely with random suffix), proceeding to login');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Login returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const data = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', data.accessToken || '');",
                  "  pm.collectionVariables.set('userId', data.userId || (data.user && data.user.id) || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "}",
                  "",
                  "pm.test('AccessToken is set', () => {",
                  "  pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Chat - Core Messaging",
      "item": [
        {
          "name": "POST /chat - Normal neutral message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/chatbot/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "chatbot", "chat"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Jag mar ganska bra idag, jag har precis varit ute och promenerat.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Chat returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Response has non-empty text', () => {",
                  "  pm.expect(data.response).to.be.a('string');",
                  "  pm.expect(data.response.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Response includes camelCase fields', () => {",
                  "  pm.expect(data).to.have.property('emotionsDetected');",
                  "  pm.expect(data).to.have.property('suggestedActions');",
                  "  pm.expect(data).to.have.property('crisisDetected');",
                  "  pm.expect(data.crisisDetected).to.eql(false);",
                  "});",
                  "",
                  "console.log('Chat response length=' + (data.response || '').length);"
                ]
              }
            }
          ]
