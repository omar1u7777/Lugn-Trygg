{
  "info": {
    "name": "Lugn & Trygg - Journal API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "7d4e1c9a-3f6b-4a82-9c1d-5b8e2f7a6c30",
    "description": "E2E test collection for personal journal routes (src/routes/journal_routes.py). Covers create/list/get/update/delete of journal entries, authorization checks (user can only touch their own journal), input validation (content length/word count, mood range, tag format, user_id/entry_id format), and negative paths (no auth, invalid path params, not-found). All journal content bodies use clearly neutral, benign language."
  },
  "variable": [
    { "key": "baseUrl", "value": "https://lugn-trygg-backend.onrender.com" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "testPassword", "value": "AuditP@ss2026x!" },
    { "key": "testUuid", "value": "" },
    { "key": "entryId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique UUID for this run if not set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-journal_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Journal Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  const responseData = body.data || body;",
                  "  if (responseData.accessToken) pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  if (responseData.userId) pm.collectionVariables.set('userId', responseData.userId);",
                  "  else if (responseData.uid) pm.collectionVariables.set('userId', responseData.uid);",
                  "  console.log('Registered new user, token set');",
                  "} else if (status === 409) {",
                  "  console.log('User already exists, will login next');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-journal_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Login returns 200 or 429 (rate limited)', () => {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.collectionVariables.set('userId', responseData.userId || responseData.uid || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "",
                  "  pm.test('AccessToken is set', () => {",
                  "    pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "  });",
                  "  pm.test('userId looks like a valid Firebase UID (needed for journal user_id path param validation)', () => {",
                  "    pm.expect(pm.collectionVariables.get('userId')).to.match(/^[a-zA-Z0-9]{20,128}$/);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Create Journal Entry",
      "item": [
        {
          "name": "POST /{{userId}}/journal - Create valid entry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/journal/{{userId}}/journal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "journal", "{{userId}}", "journal"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Feeling okay today, went for a walk in the park\",\n  \"mood\": 7,\n  \"tags\": [\"calm\", \"walk\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Create entry returns 201', () => {",
                  "  pm.expect(status).to.eql(201);",
                  "});",
                  "",
                  "pm.test('Response has entry id, content, mood, tags, timestamps', () => {",
                  "  pm.expect(data).to.have.property('id');",
                  "  pm.expect(data.content).to.eql('Feeling okay today, went for a walk in the park');",
                  "  pm.expect(data.mood).to.eql(7);",
                  "  pm.expect(data.tags).to.include('calm');",
                  "  pm.expect(data).to.have.property('createdAt');",
                  "  pm.expect(data).to.have.property('updatedAt');",
                  "});",
                  "",
                  "if (data.id) pm.collectionVariables.set('entryId', data.id);",
                  "console.log('Created entry id=' + data.id);"
                ]
              }
            }
          ]
        },
