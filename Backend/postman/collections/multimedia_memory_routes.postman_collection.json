    {
      "name": "2. List Memories",
      "item": [
        {
          "name": "GET /memory-unified/list/{{userId}} - Own memories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/memory-unified/list/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "memory-unified",
                "list",
                "{{userId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List memories returns 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json().data || pm.response.json();",
                  "pm.test('Response has memories array', () => { pm.expect(data.memories).to.be.an('array'); });",
                  "pm.test('The text-only memory we created is in the list', () => {",
                  "  const found = data.memories.some(m => m.id === pm.collectionVariables.get('memoryId'));",
                  "  pm.expect(found).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
