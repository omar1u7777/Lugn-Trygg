{
  "info": {
    "name": "Lugn & Trygg - Multimedia Memory API",
    "description": "Unified text/audio/photo memory creation. File-upload paths (audio/photos) are NOT exercised here -- Firebase Storage is currently broken due to a GCP billing/bucket issue (see memory_routes collection + RUNBOOK). Text-only creation, list, and detail retrieval are fully covered.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-multimedia_memory_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E MultimediaMemory Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 201, 409 or 429', () => { pm.expect([201, 409, 429]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-multimedia_memory_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code; let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('Login returns 200 (or 429)', () => { pm.expect([200, 429]).to.include(status); });",
                  "if (status === 200) {",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.collectionVariables.set('userId', responseData.userId || (responseData.user && responseData.user.id) || '');",
                  "  pm.test('AccessToken is set', () => { pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty; });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Create Memory (text-only, no files - avoids known GCS billing outage)",
      "item": [
        {
          "name": "POST /memory-unified/create - Text only",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/memory-unified/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "memory-unified",
                "create"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "content",
                  "value": "A calm afternoon, went for a walk in the park.",
                  "type": "text"
                },
                {
                  "key": "mood",
                  "value": "7",
                  "type": "text"
                },
                {
                  "key": "tags",
                  "value": "walk,calm",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create text-only memory returns 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json().data || pm.response.json();",
                  "pm.test('Response has memoryId', () => { pm.expect(data).to.have.property('memoryId'); });",
                  "if (data.memoryId) pm.collectionVariables.set('memoryId', data.memoryId);"
                ]
              }
            }
          ]
        },
