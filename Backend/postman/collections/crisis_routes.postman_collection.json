              "path": ["api", "v1", "crisis", "assess"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood_history\": [7, 6, 7, 8],\n  \"recent_text_content\": \"Feeling okay today, went for a walk\",\n  \"days_without_social_interaction\": 0,\n  \"social_activity_trend\": 1.0,\n  \"insomnia_nights_last_week\": 0,\n  \"current_anxiety_score\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Assess returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Response has risk_level and risk_score', () => {",
                  "  pm.expect(data).to.have.property('risk_level');",
                  "  pm.expect(data).to.have.property('risk_score');",
                  "  pm.expect(data).to.have.property('active_indicators');",
                  "});",
                  "",
                  "pm.test('Benign input yields minimal/low/medium risk (not critical/high) - sanity check we did not trip crisis escalation', () => {",
                  "  pm.expect(['minimal', 'low', 'medium']).to.include(data.risk_level);",
                  "});",
                  "",
                  "console.log('Assessment risk_level=' + data.risk_level + ' score=' + data.risk_score);"
                ]
