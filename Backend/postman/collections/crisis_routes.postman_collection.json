              "mode": "raw",
              "raw": "{\n  \"current_context\": {\n    \"note\": \"feeling a bit better today, benign test context\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "console.log('check-escalation status=' + status + ' body=' + JSON.stringify(body));",
                  "",
                  "pm.test('check-escalation does not 500', () => {",
                  "  pm.expect(status).to.not.eql(500);",
                  "});",
                  "",
                  "if (status === 404) {",
                  "  console.log('BUG SUSPECT: /crisis/assess (folder 1) was called earlier in this run and returned 200, ' +",
                  "    'meaning an assessment document now exists in crisis_assessments for this user (written via .add(), auto-ID). ' +",
                  "    'But /check-escalation reads via db.collection(\\'crisis_assessments\\').document(user_id).get() - a document ' +",
                  "    'keyed by the user_id itself, which /assess never writes. Result: NO_ASSESSMENT/404 even though a prior ' +",
                  "    'assessment genuinely exists for this user. This looks like a real production logic bug (ID scheme mismatch ' +",
                  "    'between the writer in assess_crisis_risk() and the reader in check_escalation()), not a test-script issue.');",
                  "} else {",
                  "  pm.test('check-escalation returns 200 with should_escalate field when a prior assessment doc is found', () => {",
                  "    pm.expect(status).to.eql(200);",
                  "    const data = body.data || body;",
                  "    pm.expect(data).to.have.property('should_escalate');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
