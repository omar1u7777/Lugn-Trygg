                "security",
                "key-rotation",
                "status"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No auth returns 401', () => {",
                  "  pm.expect([401, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/security/key-rotation/status - Authenticated non-admin (expect 403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/security/key-rotation/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "security",
                "key-rotation",
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Non-admin returns 403 (admin-only endpoint, correctly gated)', () => {",
                  "  pm.expect(pm.response.code).to.eql(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
