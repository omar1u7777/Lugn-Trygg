          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "// 200 = success, 503 = not configured / model loading, 502/504 = upstream HF issues (acceptable, not our bug)",
                  "pm.test('MusicGen returns 200, 502, 503 or 504', () => {",
                  "  pm.expect([200, 502, 503, 504]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  pm.test('MusicGen content-type is audio/wav', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('audio/wav');",
                  "  });",
                  "  pm.test('MusicGen has non-trivial audio payload', () => {",
                  "    pm.expect(parseInt(pm.response.headers.get('Content-Length'))).to.be.above(100);",
                  "  });",
                  "} else {",
                  "  console.log('MusicGen not available in this environment, status=' + status);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
