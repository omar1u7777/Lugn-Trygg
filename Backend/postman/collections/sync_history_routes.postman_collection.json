                "sync-history",
                "retry",
                "{{successSyncId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retrying a successful sync returns 400', () => { pm.expect(pm.response.code).to.eql(400); });"
                ]
              }
            }
          ]
