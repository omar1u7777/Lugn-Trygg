    {
      "name": "4. Retry Failed Sync",
      "item": [
        {
          "name": "POST /sync-history/retry/{{failedSyncId}} - Retry a failed sync",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sync-history/retry/{{failedSyncId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "sync-history",
                "retry",
                "{{failedSyncId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retry returns 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json().data || pm.response.json();",
                  "pm.test('Has retryId', () => { pm.expect(data.retryId).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
