    {
      "name": "2. List History",
      "item": [
        {
          "name": "GET /sync-history/list - Default params",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/sync-history/list",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
