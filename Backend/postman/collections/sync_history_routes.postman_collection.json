          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get stats returns 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json().data || pm.response.json();",
                  "pm.test('totalSyncs >= 2', () => { pm.expect(data.totalSyncs).to.be.at.least(2); });",
                  "pm.test('byProvider has google_fit and fitbit', () => {",
                  "  pm.expect(data.byProvider).to.have.property('google_fit');",
                  "  pm.expect(data.byProvider).to.have.property('fitbit');",
                  "});"
