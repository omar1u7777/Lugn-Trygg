              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List returns 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json().data || pm.response.json();",
                  "pm.test('Both logged syncs present', () => {",
                  "  const ids = data.history.map(h => h.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('successSyncId'));",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('failedSyncId'));",
                  "});"
                ]
              }
            }
          ]
        },
