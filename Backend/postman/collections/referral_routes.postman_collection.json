              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Generate returns 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json().data || pm.response.json();",
                  "pm.test('Has referralCode', () => { pm.expect(data.referralCode).to.be.a('string').with.lengthOf.at.least(8); });",
                  "pm.collectionVariables.set('referralCode', data.referralCode);"
                ]
