    {
      "name": "5. Stripe Webhook - Signature Enforcement Only",
      "item": [
        {
          "name": "POST /subscription/webhook - No signature header",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscription/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "subscription",
                "webhook"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"checkout.session.completed\", \"data\": {\"object\": {}}}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unsigned webhook rejected (400 or 503)', () => { pm.expect([400, 503]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /subscription/webhook - Bogus signature header (expect rejection)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "stripe-signature",
                "value": "t=1,v1=deadbeefnotarealsignature"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/subscription/webhook",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "subscription",
                "webhook"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"type\": \"checkout.session.completed\", \"data\": {\"object\": {}}}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Forged signature rejected (400 or 503)', () => { pm.expect([400, 503]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
