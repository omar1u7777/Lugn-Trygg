      "name": "2. Temporal LSTM Forecast",
      "item": [
        {
          "name": "GET /forecast?days=7&include_patterns=true",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/advanced-mood/forecast?days=7&include_patterns=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "advanced-mood", "forecast"],
              "query": [
                { "key": "days", "value": "7" },
                { "key": "include_patterns", "value": "true" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const responseData = body.data || body;",
                  "",
                  "// 200 = forecast generated (LSTM or statistical fallback),",
                  "// 400 = fresh test account lacks the >=14 mood entries LSTM needs,",
                  "// 503 = neither LSTM nor fallback available in this deployment.",
                  "pm.test('Forecast returns 200, 400 or 503', () => {",
                  "  pm.expect([200, 400, 503]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  pm.test('Response has forecasts array and model_type', () => {",
                  "    pm.expect(responseData.forecasts).to.be.an('array');",
                  "    pm.expect(responseData).to.have.property('model_type');",
                  "  });",
                  "  console.log('Forecast model: ' + responseData.model_type);",
                  "} else {",
                  "  console.log('Forecast status ' + status + ' - acceptable for a fresh test account');",
                  "}"
                ]
              }
            }
          ]
        },
