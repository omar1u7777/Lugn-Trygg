{
  "info": {
    "name": "Lugn & Trygg - Advanced Mood Routes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "144180e0-53d4-44a9-888c-347b82962602",
    "description": "E2E test collection covering all routes in src/routes/advanced_mood_routes.py (registered under /api/v1/advanced-mood): Swedish BERT NLP mood analysis, Temporal LSTM forecasting, PHQ-9/GAD-7 clinical assessments, micro-journaling smart prompts/quick-log/tag-suggestions, and streak gamification. All optional ML services (NLP_AVAILABLE, LSTM_AVAILABLE, CLINICAL_AVAILABLE, JOURNALING_AVAILABLE) are feature-flagged in the backend, so tests accept 200 or 503 as valid outcomes where a service may be unavailable in the deployed environment. All free-text bodies use neutral, benign content ('Kande mig lugn idag, tog en promenad') to avoid triggering real crisis-detection alerts."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lugn-trygg-backend.onrender.com"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "AuditP@ss2026x!"
    },
    {
      "key": "testUuid",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique UUID for this run if not set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-advanced_mood_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Advanced Mood Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "// 201 = new user, 409 = already exists, 429 = rate limited (all acceptable)",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  pm.collectionVariables.set('testEmail', 'e2e-advanced_mood_routes-' + pm.collectionVariables.get('testUuid') + '@test.lugntrygg.se');",
                  "  console.log('Registered new advanced_mood test user');",
                  "} else if (status === 409) {",
                  "  console.log('User already exists, will login next');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-advanced_mood_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Login returns 200 or 429', () => {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.collectionVariables.set('userId', responseData.userId || (responseData.user && responseData.user.id) || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "  pm.test('AccessToken is set', () => {",
                  "    pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Swedish BERT NLP Analysis",
      "item": [
        {
          "name": "POST /analyze - Valid neutral text",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/advanced-mood/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "advanced-mood", "analyze"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Kande mig lugn och avslappnad idag, tog en langpromenad i solen.\",\n  \"include_clinical\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const responseData = body.data || body;",
                  "",
                  "pm.test('Analyze returns 200 or 503 (NLP service may be unavailable)', () => {",
                  "  pm.expect([200, 503]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  pm.test('Response has valence/arousal/dominance/primary_emotion', () => {",
                  "    pm.expect(responseData).to.have.property('valence');",
                  "    pm.expect(responseData).to.have.property('arousal');",
                  "    pm.expect(responseData).to.have.property('dominance');",
                  "    pm.expect(responseData).to.have.property('primary_emotion');",
                  "    pm.expect(responseData).to.have.property('intensity');",
                  "    pm.expect(responseData).to.have.property('confidence');",
                  "  });",
                  "  console.log('Primary emotion: ' + responseData.primary_emotion);",
                  "} else {",
                  "  console.log('NLP service unavailable (503) - acceptable in this deployment');",
                  "}"
                ]
              }
            }
          ]
        },
