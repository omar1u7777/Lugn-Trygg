    },
    {
      "name": "2. Mood Statistics",
      "item": [
        {
          "name": "GET /statistics - Comprehensive mood stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mood-stats/statistics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "mood-stats", "statistics"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const responseData = body.data || body;",
                  "",
                  "pm.test('Statistics returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Response has all documented statistics fields', () => {",
                  "  pm.expect(responseData).to.have.property('totalMoods');",
                  "  pm.expect(responseData).to.have.property('averageSentiment');",
                  "  pm.expect(responseData).to.have.property('currentStreak');",
                  "  pm.expect(responseData).to.have.property('longestStreak');",
                  "  pm.expect(responseData).to.have.property('positivePercentage');",
                  "  pm.expect(responseData).to.have.property('negativePercentage');",
                  "  pm.expect(responseData).to.have.property('neutralPercentage');",
                  "  pm.expect(responseData).to.have.property('bestDay');",
                  "  pm.expect(responseData).to.have.property('worstDay');",
                  "  pm.expect(responseData).to.have.property('recentTrend');",
                  "});",
                  "",
                  "pm.test('totalMoods is a non-negative number', () => {",
                  "  pm.expect(responseData.totalMoods).to.be.a('number');",
                  "  pm.expect(responseData.totalMoods).to.be.at.least(0);",
                  "});",
                  "",
                  "console.log('totalMoods=' + responseData.totalMoods + ' recentTrend=' + responseData.recentTrend);"
                ]
              }
            }
          ]
        }
      ]
    },
