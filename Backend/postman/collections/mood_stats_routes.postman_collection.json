{
  "info": {
    "name": "Lugn & Trygg - Mood Stats Routes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "6f2a9e1c-3b7d-4e2a-9c1a-8f6a0d5e7b31",
    "description": "E2E test collection covering all routes in src/routes/mood_stats_routes.py (registered under /api/v1/mood-stats): comprehensive mood statistics, daily analytics, and monthly analytics. All routes are read-only (GET) and require JWT auth. A couple of benign mood log entries are seeded first (via /api/v1/mood/log) so the statistics/analytics endpoints have real data to aggregate. All free-text bodies use neutral, benign content ('Feeling okay today, went for a walk') to avoid triggering real crisis-detection alerts."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lugn-trygg-backend.onrender.com"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "AuditP@ss2026x!"
    },
    {
      "key": "testUuid",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique UUID for this run if not set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-mood_stats_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Mood Stats Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "// 201 = new user, 409 = already exists, 429 = rate limited (all acceptable)",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  pm.collectionVariables.set('testEmail', 'e2e-mood_stats_routes-' + pm.collectionVariables.get('testUuid') + '@test.lugntrygg.se');",
                  "  console.log('Registered new mood_stats test user');",
                  "} else if (status === 409) {",
                  "  console.log('User already exists, will login next');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-mood_stats_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Login returns 200 or 429', () => {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.collectionVariables.set('userId', responseData.userId || (responseData.user && responseData.user.id) || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "  pm.test('AccessToken is set', () => {",
                  "    pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Seed Mood Data",
      "item": [
        {
          "name": "POST /api/v1/mood/log - Seed entry 1 (neutral, benign)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mood/log",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "mood", "log"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood_text\": \"Bra\",\n  \"note\": \"Feeling okay today, went for a walk\",\n  \"score\": 7,\n  \"tags\": [\"walk\", \"outdoors\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "// 201/200 = logged, 429 = daily quota reached (acceptable for a plan-limited account),",
                  "// 503 = downstream service unavailable (acceptable in this deployment)",
                  "pm.test('Seed mood log returns 200, 201, 429 or 503', () => {",
                  "  pm.expect([200, 201, 429, 503]).to.include(status);",
                  "});",
                  "console.log('Seed entry 1 status: ' + status);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/mood/log - Seed entry 2 (neutral, benign)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/mood/log",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "mood", "log"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mood_text\": \"Neutral\",\n  \"note\": \"Calm afternoon, read a book at home\",\n  \"score\": 5,\n  \"tags\": [\"reading\", \"home\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Seed mood log returns 200, 201, 429 or 503', () => {",
                  "  pm.expect([200, 201, 429, 503]).to.include(status);",
                  "});",
                  "console.log('Seed entry 2 status: ' + status);"
                ]
              }
            }
          ]
