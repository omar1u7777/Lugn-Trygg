        {
          "name": "SECURITY PROBE: POST /submit - user_id in body does not match authenticated token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/feedback/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "feedback", "submit"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{spoofedUserId}}\",\n  \"rating\": 3,\n  \"category\": \"general\",\n  \"message\": \"Security probe: submitting feedback attributed to a user_id that is not the authenticated caller.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "// The route reads user_id from the JSON body (input_sanitizer.sanitize(data.get('user_id'))),",
                  "// not from g.get('user_id') / the JWT subject. A spoofedUserId that merely satisfies the",
                  "// 20-128 alphanumeric regex should NOT be accepted for an authenticated request whose",
                  "// token subject is a different user - if it returns 200, that is an IDOR: any authenticated",
                  "// caller can attribute feedback (and increment feedback_submissions / last_feedback_at) to",
                  "// an arbitrary user_id string.",
                  "pm.test('DOCUMENTS BEHAVIOR: does /submit accept a user_id that does not match the JWT subject?', () => {",
                  "  console.log('Status for mismatched user_id: ' + status);",
                  "  if (status === 200) {",
                  "    console.log('SECURITY FINDING: /submit stored feedback for spoofedUserId=' + pm.collectionVariables.get('spoofedUserId') + ' while authenticated as userId=' + pm.collectionVariables.get('userId') + '. The endpoint does not verify that body.user_id matches the JWT-authenticated identity (IDOR).');",
                  "  } else {",
                  "    console.log('Endpoint rejected mismatched user_id with status ' + status + ' (no IDOR observed).');",
                  "  }",
                  "  pm.expect(status).to.be.oneOf([200, 400, 401, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
