          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-feedback_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Feedback Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  const responseData = body.data || body;",
                  "  const user = responseData.user || responseData;",
                  "  if (responseData.accessToken) pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  if (user.id) pm.collectionVariables.set('userId', user.id);",
                  "  else if (responseData.userId) pm.collectionVariables.set('userId', responseData.userId);",
                  "  console.log('Registered new user, userId=' + pm.collectionVariables.get('userId'));",
                  "} else if (status === 409) {",
                  "  console.log('User already exists, will login next');",
                  "}"
                ]
              }
            }
          ]
        },
