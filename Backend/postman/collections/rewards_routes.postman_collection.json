          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get catalog returns 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json().data || pm.response.json();",
                  "pm.test('Only purchasable rewards (cost > 0)', () => {",
                  "  pm.expect(data.rewards).to.be.an('array').with.length.above(0);",
                  "  pm.expect(data.rewards.every(r => r.cost > 0)).to.eql(true);",
                  "});"
