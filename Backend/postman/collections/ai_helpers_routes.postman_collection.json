                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai-helpers/analyze-text",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai-helpers", "analyze-text"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"{{oversizedText}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build a benign, neutral 2100-char string (well above the 2000-char server limit)",
                  "const longText = ('Feeling okay today, went for a walk. ').repeat(60).slice(0, 2100);",
                  "pm.collectionVariables.set('oversizedText', longText);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
