                  "",
                  "pm.test('Authenticated user requesting another valid-format UID gets 403 FORBIDDEN, not the data', () => {",
                  "  pm.expect(status).to.eql(403);",
                  "  pm.expect(body.success).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
