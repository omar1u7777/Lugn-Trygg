{
  "info": {
    "name": "Lugn & Trygg - Dashboard API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "f3a7c2e1-9b4d-4a6e-8c1f-2d5e7b9a3c04",
    "description": "E2E test collection for the dashboard batching routes (src/routes/dashboard_routes.py). Covers CSRF token issuance, dashboard summary, quick stats, and the legacy /api/dashboard and /api/dashboard/stats proxy endpoints. Read-only domain - no state-mutating requests. Includes negative paths (no auth, wrong user ownership, invalid user id format)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lugn-trygg-backend.onrender.com"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "AuditP@ss2026x!"
    },
    {
      "key": "testUuid",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique UUID for this run if not set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-dashboard_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Dashboard Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  const responseData = body.data || body;",
                  "  if (responseData.accessToken) pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  if (responseData.userId) pm.collectionVariables.set('userId', responseData.userId);",
                  "  else if (responseData.uid) pm.collectionVariables.set('userId', responseData.uid);",
                  "  console.log('Registered new user, token set');",
                  "} else if (status === 409) {",
                  "  console.log('User already exists, will login next');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-dashboard_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Login returns 200 or 429 (rate limited)', () => {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.collectionVariables.set('userId', responseData.userId || responseData.uid || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "",
                  "  pm.test('AccessToken is set', () => {",
                  "    pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "  });",
                  "",
                  "  pm.test('UserId is set and matches Firebase UID pattern', () => {",
                  "    const uid = pm.collectionVariables.get('userId');",
                  "    pm.expect(uid).to.not.be.empty;",
                  "    pm.expect(/^[a-zA-Z0-9]{20,128}$/.test(uid)).to.eql(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Dashboard - CSRF Token",
      "item": [
        {
          "name": "GET /dashboard/csrf-token - Issue CSRF token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dashboard/csrf-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dashboard", "csrf-token"]
            },
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('CSRF token endpoint returns 200 without auth', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Response contains a non-trivial csrfToken', () => {",
                  "  pm.expect(data.csrfToken).to.be.a('string');",
                  "  pm.expect(data.csrfToken.length).to.be.above(20);",
                  "});",
                  "",
                  "pm.test('Set-Cookie header sets the CSRF cookie', () => {",
                  "  const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "  pm.expect(setCookie).to.include('csrf_token=');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /dashboard/csrf-token - Two calls yield different tokens",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dashboard/csrf-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dashboard", "csrf-token"]
            },
            "auth": { "type": "noauth" }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('baseUrl') + '/api/v1/dashboard/csrf-token',",
                  "  method: 'GET'",
                  "}, (err, res) => {",
                  "  if (!err && res.code === 200) {",
                  "    const body = res.json();",
                  "    const data = body.data || body;",
                  "    pm.collectionVariables.set('firstCsrfToken', data.csrfToken || '');",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Second CSRF call returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('CSRF tokens are unique per request', () => {",
                  "  const first = pm.collectionVariables.get('firstCsrfToken');",
                  "  if (first) {",
                  "    pm.expect(data.csrfToken).to.not.eql(first);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Dashboard - Summary",
      "item": [
        {
          "name": "GET /dashboard/{{userId}}/summary - Full summary (cache miss)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dashboard/{{userId}}/summary?forceRefresh=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dashboard", "{{userId}}", "summary"],
              "query": [{ "key": "forceRefresh", "value": "true" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Summary returns 200 for own user id', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Summary has all documented fields with correct types', () => {",
                  "  pm.expect(data.totalMoods).to.be.a('number');",
                  "  pm.expect(data.totalChats).to.be.a('number');",
                  "  pm.expect(data.averageMood).to.be.a('number');",
                  "  pm.expect(data.streakDays).to.be.a('number');",
                  "  pm.expect(data.weeklyGoal).to.be.a('number');",
                  "  pm.expect(data.weeklyProgress).to.be.a('number');",
                  "  pm.expect(data.wellnessGoals).to.be.an('array');",
                  "  pm.expect(data.goalStepCompletions).to.be.an('object');",
                  "  pm.expect(data.recentActivity).to.be.an('array');",
                  "  pm.expect(data.moodTrendSamples).to.be.an('array');",
                  "  pm.expect(data.longestStreak).to.be.a('number');",
                  "  pm.expect(data.weeklyChats).to.be.a('number');",
                  "  pm.expect(data.achievementsCount).to.be.a('number');",
                  "  pm.expect(data.totalMeditations).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('forceRefresh=true bypasses cache (cached=false)', () => {",
                  "  pm.expect(data.cached).to.eql(false);",
                  "});",
                  "",
                  "pm.test('For a brand-new user, moods/chats/meditations are all zero', () => {",
                  "  pm.expect(data.totalMoods).to.eql(0);",
                  "  pm.expect(data.totalChats).to.eql(0);",
                  "  pm.expect(data.totalMeditations).to.eql(0);",
                  "  pm.expect(data.recentActivity).to.be.an('array').that.is.empty;",
                  "});",
                  "",
                  "console.log('Summary: moods=' + data.totalMoods + ' chats=' + data.totalChats + ' responseTime=' + data.responseTime + 'ms');"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /dashboard/{{userId}}/summary - Second call hits 5-minute cache",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dashboard/{{userId}}/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dashboard", "{{userId}}", "summary"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Summary (no forceRefresh) returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Second call within 5 minutes is served from cache', () => {",
                  "  pm.expect(data.cached).to.eql(true);",
                  "});",
                  "",
                  "console.log('Cached summary cached=' + data.cached);"
                ]
              }
            }
          ]
        }
      ]
    },
