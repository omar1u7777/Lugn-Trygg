{
  "info": {
    "name": "Lugn & Trygg - Leaderboard API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b4f3a1d2-6c9e-4a7f-8b1d-9e2c5f7a3d61",
    "description": "E2E test collection for the leaderboard/ranking routes (src/routes/leaderboard_routes.py). All 6 routes are read-only GET endpoints (XP leaderboard, streak leaderboard, mood leaderboard, per-user rank lookup via two aliased paths, and weekly winners) backed by Firestore aggregation queries. None of these routes write any data, so every request in this collection is safe to execute live - there is no 'Not Executed For Safety' folder."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lugn-trygg-backend.onrender.com"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "AuditP@ss2026x!"
    },
    {
      "key": "testUuid",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique UUID for this run if not set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-leaderboard_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Leaderboard Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  const responseData = body.data || body;",
                  "  if (responseData.accessToken) pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  if (responseData.user && responseData.user.id) pm.collectionVariables.set('userId', responseData.user.id);",
                  "  else if (responseData.userId) pm.collectionVariables.set('userId', responseData.userId);",
                  "  console.log('Registered new user, will login next for tokens');",
                  "} else if (status === 409) {",
                  "  console.log('User already exists, will login next');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-leaderboard_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Login returns 200 or 429 (rate limited)', () => {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.collectionVariables.set('userId', responseData.userId || (responseData.user && responseData.user.id) || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "",
                  "  pm.test('AccessToken is set', () => {",
                  "    pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "  });",
                  "",
                  "  pm.test('userId matches expected format (20-128 alphanumeric chars)', () => {",
                  "    pm.expect(pm.collectionVariables.get('userId')).to.match(/^[a-zA-Z0-9]{20,128}$/);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. XP Leaderboard",
      "item": [
        {
          "name": "GET /leaderboard/xp - Default limit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/leaderboard/xp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "leaderboard", "xp"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('XP leaderboard returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const data = body.data || body;",
                  "",
                  "  pm.test('Response has leaderboard array', () => {",
                  "    pm.expect(data.leaderboard).to.be.an('array');",
                  "  });",
                  "",
                  "  pm.test('Response has timeframe and updatedAt', () => {",
                  "    pm.expect(data).to.have.property('timeframe');",
                  "    pm.expect(data).to.have.property('updatedAt');",
                  "  });",
                  "",
                  "  if (data.leaderboard.length > 0) {",
                  "    const entry = data.leaderboard[0];",
                  "    pm.test('Leaderboard entry has expected shape', () => {",
                  "      pm.expect(entry).to.have.property('rank');",
                  "      pm.expect(entry).to.have.property('userId');",
                  "      pm.expect(entry).to.have.property('displayName');",
                  "      pm.expect(entry).to.have.property('xp');",
                  "      pm.expect(entry).to.have.property('badgeCount');",
                  "    });",
                  "    pm.test('Entries are sorted descending by xp', () => {",
                  "      for (let i = 1; i < data.leaderboard.length; i++) {",
                  "        pm.expect(data.leaderboard[i].xp).to.be.at.most(data.leaderboard[i - 1].xp);",
                  "      }",
                  "    });",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
