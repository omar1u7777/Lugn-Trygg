                "status"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get status returns 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json().data || pm.response.json();",
                  "pm.test('Has googleSpeech and webSpeechFallback fields', () => {",
                  "  pm.expect(data).to.have.property('googleSpeech');",
                  "  pm.expect(data).to.have.property('webSpeechFallback');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
