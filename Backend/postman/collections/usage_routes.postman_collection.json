          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Increment mood returns 200 or 429 (limit reached)', () => {",
                  "  pm.expect([200, 429]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  const data = body.data || body;",
                  "  pm.test('Response has mood_logs and limit', () => {",
                  "    pm.expect(data).to.have.property('mood_logs');",
                  "    pm.expect(data).to.have.property('limit');",
                  "  });",
                  "}"
