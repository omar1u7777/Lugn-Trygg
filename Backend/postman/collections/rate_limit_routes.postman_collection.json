{
  "info": {
    "name": "Lugn & Trygg - Rate Limit API",
    "description": "Rate limit status/test endpoints (regular user) plus admin-only config/stats/reset (scope limited to verifying the admin gate, no real admin action attempted).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-rate_limit_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E RateLimit Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code; let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-rate_limit_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code; let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('Login returns 200 (or 429 if rate limited)', () => {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "if (status === 200) {",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.test('AccessToken is set', () => {",
                  "    pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Rate Limit Status (own tier)",
      "item": [
        {
          "name": "GET /rate-limit/status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rate-limit/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rate-limit",
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get status returns 200', () => { pm.expect(pm.response.code).to.eql(200); });",
                  "const data = pm.response.json().data || pm.response.json();",
                  "pm.test('Has userTier and endpointLimits', () => {",
                  "  pm.expect(data).to.have.property('userTier');",
                  "  pm.expect(data).to.have.property('endpointLimits');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /rate-limit/status - No auth (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rate-limit/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rate-limit",
                "status"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No auth returns 401', () => { pm.expect([401, 403]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Test Rate Limit (own category)",
      "item": [
        {
          "name": "POST /rate-limit/test/mood - Valid category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/rate-limit/test/mood",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "rate-limit",
                "test",
                "mood"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Test rate limit returns 200 or 429', () => { pm.expect([200, 429]).to.include(pm.response.code); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data || pm.response.json();",
                  "  pm.test('Has remaining and limit', () => {",
                  "    pm.expect(data).to.have.property('remaining');",
                  "    pm.expect(data).to.have.property('limit');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
