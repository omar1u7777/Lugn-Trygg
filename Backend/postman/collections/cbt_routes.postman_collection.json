        {
          "name": "GET /insights - User CBT insights",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cbt/insights",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cbt", "insights"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const responseData = body.data || body;",
                  "",
                  "pm.test('Insights returns 200 or 403', () => {",
                  "  pm.expect([200, 403]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const insights = responseData.insights;",
                  "  pm.test('Insights has documented fields', () => {",
                  "    pm.expect(insights).to.have.property('overallProgress');",
                  "    pm.expect(insights).to.have.property('strengthAreas');",
                  "    pm.expect(insights).to.have.property('improvementAreas');",
                  "    pm.expect(insights).to.have.property('recommendedNextSteps');",
                  "    pm.expect(insights).to.have.property('streak');",
                  "    pm.expect(insights.streak).to.have.property('current');",
                  "    pm.expect(insights.streak).to.have.property('longest');",
                  "    pm.expect(insights.streak).to.have.property('consistencyRating');",
                  "    pm.expect(insights).to.have.property('exercisesCompleted');",
                  "    pm.expect(insights).to.have.property('modulesCompleted');",
                  "  });",
                  "  pm.test('exercisesCompleted reflects the 3 progress calls made earlier', () => {",
                  "    pm.expect(insights.exercisesCompleted).to.be.at.least(3);",
                  "  });",
                  "  console.log('Overall progress: ' + insights.overallProgress);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
