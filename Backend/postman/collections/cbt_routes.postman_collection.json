{
  "info": {
    "name": "Lugn & Trygg - CBT Routes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "d4a1e6f0-2c9b-4a3d-9e7f-1b8c5d3a6f02",
    "description": "E2E test collection covering all CBT (Cognitive Behavioral Therapy) routes: modules, personalized session, exercises, progress tracking, and insights. Uses collection variables for auth token and dynamic test data chaining. New accounts get an automatic account-bound trial, which grants CBT (premium) access."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lugn-trygg-backend.onrender.com"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "csrfCookie",
      "value": ""
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "AuditP@ss2026x!"
    },
    {
      "key": "testUuid",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique UUID for this run if not set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}",
          "// Auto-inject CSRF headers if set (harmless no-op for Bearer-authenticated",
          "// requests, since the backend's CSRF middleware exempts any request that",
          "// carries a valid Authorization: Bearer header)",
          "if (pm.collectionVariables.get('csrfToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'X-CSRF-Token',",
          "    value: pm.collectionVariables.get('csrfToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-cbt_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E CBT Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "// 201 = new user, 409 = already exists, 429 = rate limited (all acceptable)",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  pm.collectionVariables.set('testEmail', 'e2e-cbt_routes-' + pm.collectionVariables.get('testUuid') + '@test.lugntrygg.se');",
                  "  console.log('Registered new CBT test user');",
                  "} else if (status === 409) {",
                  "  console.log('User already exists, will login next');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-cbt_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Login returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.collectionVariables.set('userId', responseData.userId || (responseData.user && responseData.user.id) || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "}",
                  "",
                  "pm.test('AccessToken is set', () => {",
                  "  pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dashboard/csrf-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "dashboard", "csrf-token"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('CSRF returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('csrfToken', responseData.csrfToken || '');",
                  "  const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "  const match = setCookie.match(/csrf_token=([^;]+)/);",
                  "  if (match) pm.collectionVariables.set('csrfCookie', match[1]);",
                  "  console.log('CSRF token set');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. CBT - Modules",
      "item": [
        {
          "name": "GET /modules - List all CBT modules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cbt/modules",
              "host": ["{{baseUrl}}"],
