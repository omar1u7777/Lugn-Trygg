            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const responseData = body.data || body;",
                  "",
                  "// 200 = trial/premium access granted, 403 = free plan without active trial",
                  "pm.test('Modules list returns 200 or 403 (premium required)', () => {",
                  "  pm.expect([200, 403]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  pm.test('Modules is a non-empty array', () => {",
                  "    pm.expect(responseData.modules).to.be.an('array');",
                  "    pm.expect(responseData.modules.length).to.be.above(0);",
                  "  });",
                  "  pm.test('Each module has completion/lock flags', () => {",
                  "    responseData.modules.forEach((m) => {",
                  "      pm.expect(m).to.have.property('moduleId');",
                  "      pm.expect(m).to.have.property('isCompleted');",
                  "      pm.expect(m).to.have.property('isLocked');",
                  "    });",
                  "  });",
                  "  console.log('Modules returned: ' + responseData.modules.length);",
                  "} else {",
                  "  pm.test('403 has PREMIUM_REQUIRED error code', () => {",
                  "    pm.expect(body.error_code || body.errorCode).to.eql('PREMIUM_REQUIRED');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
