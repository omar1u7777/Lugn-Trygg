{
  "info": {
    "name": "Lugn & Trygg - Auth API",
    "description": "Registration, login, refresh/logout, Google OAuth, password reset, consent, email/password change, 2FA enrollment, data export, and account-deletion access control. DELETE /auth/delete-account/<user_id> is scoped to access-control verification only -- never actually executed, same destructive-action boundary established earlier in this audit for privacy_routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "-1. Refresh Token (no cookie yet, runs before any login)",
      "item": [
        {
          "name": "POST /auth/refresh - Without a valid refresh cookie (expect 401)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No refresh cookie returns 401', () => { pm.expect(pm.response.code).to.eql(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "0. Register / Login / Refresh / Logout",
      "item": [
        {
          "name": "POST /auth/register - Valid registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-auth_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Auth Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code; let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('Register returns 201, 409 or 429', () => { pm.expect([201, 409, 429]).to.include(status); });",
                  "if (status === 201) {",
                  "  const responseData = body.data || body;",
                  "  const user = responseData.user || responseData;",
                  "  if (user.id) pm.collectionVariables.set('userId', user.id);",
                  "}"
                ]
              }
            }
          ]
        },
