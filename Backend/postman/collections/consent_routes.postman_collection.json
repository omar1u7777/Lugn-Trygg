              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Validate feature returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Unrecognized feature has no requirements and defaults to access_granted=true', () => {",
                  "  pm.expect(data.access_granted).to.eql(true);",
                  "  pm.expect(data.required_consents).to.be.an('array').that.is.empty;",
                  "});",
                  "",
                  "console.log('NOTE: unmapped feature names silently pass consent validation - confirm this fail-open behavior is intended for any new/renamed feature keys.');"
                ]
              }
            }
          ]
        }
      ]
