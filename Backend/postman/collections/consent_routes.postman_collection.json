                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Validate feature returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('voice_analysis access is denied (voice_processing consent never granted)', () => {",
                  "  pm.expect(data.access_granted).to.eql(false);",
                  "  pm.expect(data.missing_consents.length).to.be.above(0);",
                  "  const types = data.missing_consents.map(c => c.type);",
                  "  pm.expect(types).to.include('voice_processing');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /consent/validate/unknown_feature_xyz - Unknown feature defaults to granted",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/consent/validate/unknown_feature_xyz",
              "host": ["{{baseUrl}}"],
