{
  "info": {
    "name": "Lugn & Trygg - Consent API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "d4a1e6f2-7c3b-4e91-9a2d-5b8f1c0e6a72",
    "description": "E2E test collection for GDPR consent management routes (src/routes/consent_routes.py). Covers bulk consent grant/withdraw, single-type grant/withdraw/check, feature-access validation, and negative paths (no auth, unknown consent type, invalid path param)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lugn-trygg-backend.onrender.com"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "AuditP@ss2026x!"
    },
    {
      "key": "testUuid",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique UUID for this run if not set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-consent_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Consent Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  const responseData = body.data || body;",
                  "  if (responseData.accessToken) pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  if (responseData.userId) pm.collectionVariables.set('userId', responseData.userId);",
                  "  else if (responseData.uid) pm.collectionVariables.set('userId', responseData.uid);",
                  "  console.log('Registered new user, token set');",
                  "} else if (status === 409) {",
                  "  console.log('User already exists, will login next');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-consent_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Login returns 200 or 429 (rate limited)', () => {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.collectionVariables.set('userId', responseData.userId || responseData.uid || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "",
                  "  pm.test('AccessToken is set', () => {",
                  "    pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Consent - Bulk Operations",
      "item": [
        {
          "name": "POST /consent - Bulk grant consents",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/consent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "consent"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"terms_of_service\": true,\n  \"privacy_policy\": true,\n  \"data_processing_consent\": true,\n  \"ai_analysis_consent\": true,\n  \"analytics_consent\": true,\n  \"marketing_consent\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Bulk grant returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Response has granted array with expected types', () => {",
                  "  pm.expect(data.granted).to.be.an('array');",
                  "  pm.expect(data.granted).to.include('terms_of_service');",
                  "  pm.expect(data.granted).to.include('privacy_policy');",
                  "  pm.expect(data.granted).to.include('data_processing');",
                  "  pm.expect(data.granted).to.include('ai_processing');",
                  "  pm.expect(data.granted).to.include('analytics');",
                  "});",
                  "",
                  "pm.test('Nothing failed', () => {",
                  "  pm.expect(data.failed).to.be.an('array').that.is.empty;",
                  "});",
                  "",
                  "console.log('Bulk granted=' + JSON.stringify(data.granted));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /consent - Get all user consents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/consent",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "consent"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Get consents returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Consent map contains known consent types', () => {",
                  "  pm.expect(data).to.have.property('terms_of_service');",
                  "  pm.expect(data).to.have.property('analytics');",
                  "  pm.expect(data).to.have.property('marketing');",
                  "});",
                  "",
                  "pm.test('Previously granted consent shows has_consent=true', () => {",
                  "  pm.expect(data.terms_of_service.status.has_consent).to.eql(true);",
                  "  pm.expect(data.analytics.status.has_consent).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Never-granted consent shows has_consent=false', () => {",
                  "  pm.expect(data.marketing.status.has_consent).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
