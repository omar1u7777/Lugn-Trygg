              "raw": "{\n  \"mood_text\": \"Bra\",\n  \"note\": \"Feeling okay today, went for a walk\",\n  \"score\": 7,\n  \"valence\": 7,\n  \"arousal\": 5,\n  \"tags\": [\"walk\", \"outdoors\"],\n  \"context\": \"afternoon\",\n  \"timestamp\": \"2026-07-30T09:00:00Z\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const responseData = body.data || body;",
                  "",
                  "pm.test('Log mood returns 201 or 429 (daily quota)', () => {",
                  "  pm.expect([201, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  pm.test('Response has moodEntry with id', () => {",
                  "    pm.expect(responseData.moodEntry).to.exist;",
                  "    pm.expect(responseData.moodEntry.id).to.be.a('string');",
                  "  });",
                  "  pm.collectionVariables.set('moodId', responseData.moodEntry.id);",
                  "  console.log('Created moodId=' + responseData.moodEntry.id);",
                  "} else {",
                  "  console.log('Mood log quota reached (429) - acceptable, non-blocking for this run');",
                  "}"
                ]
              }
            }
          ]
        },
