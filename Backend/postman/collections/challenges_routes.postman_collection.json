          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/challenges/{{challengeId}}/contribute",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "challenges", "{{challengeId}}", "contribute"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"journal\",\n  \"amount\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The category-mismatch branch is only reachable once the user is a",
