                  "// Skipped for safety."
                ]
              }
            }
          ]
        },
        {
          "name": "[SKIPPED] POST /challenges/{{challengeId}}/leave - Leave challenge",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/challenges/{{challengeId}}/leave",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "challenges", "{{challengeId}}", "leave"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// leave_challenge() unconditionally calls challenge_ref.update() on the",
