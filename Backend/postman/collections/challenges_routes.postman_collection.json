{
  "info": {
    "name": "Lugn & Trygg - Challenges API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "e7f2a9c4-3d6b-4a81-9f5c-2b7e4d8a1c93",
    "description": "E2E test collection for team-based wellness challenges routes (src/routes/challenges_routes.py). Covers list/get challenges, join/leave/contribute (negative paths only are executed live), per-user challenge lookup with ownership check, and the maintenance cleanup endpoint. Requests that would write real progress/membership into the shared, production community challenges (visible to real other app users) are kept in a dedicated 'Not Executed For Safety' folder and are NOT run in the live audit."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://lugn-trygg-backend.onrender.com"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "AuditP@ss2026x!"
    },
    {
      "key": "testUuid",
      "value": ""
    },
    {
      "key": "challengeId",
      "value": ""
    },
    {
      "key": "challengeCategory",
      "value": ""
    },
    {
      "key": "secondChallengeId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique UUID for this run if not set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-challenges_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E Challenges Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Register returns 201, 409 or 429 (rate limited)', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  const responseData = body.data || body;",
                  "  if (responseData.accessToken) pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  if (responseData.user && responseData.user.id) pm.collectionVariables.set('userId', responseData.user.id);",
                  "  else if (responseData.userId) pm.collectionVariables.set('userId', responseData.userId);",
                  "  console.log('Registered new user, will login next for tokens');",
                  "} else if (status === 409) {",
                  "  console.log('User already exists, will login next');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"e2e-challenges_routes-{{testUuid}}@test.lugntrygg.se\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Login returns 200 or 429 (rate limited)', () => {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken);",
                  "  pm.collectionVariables.set('userId', responseData.userId || (responseData.user && responseData.user.id) || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "",
                  "  pm.test('AccessToken is set', () => {",
                  "    pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Read Challenges",
      "item": [
        {
          "name": "GET /challenges - List active challenges",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/challenges",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "challenges"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('List challenges returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const data = body.data || body;",
                  "",
                  "  pm.test('Response has challenges array', () => {",
                  "    pm.expect(data.challenges).to.be.an('array');",
                  "  });",
                  "",
                  "  const list = data.challenges || [];",
                  "  if (list.length > 0) {",
                  "    pm.collectionVariables.set('challengeId', list[0].id);",
                  "    pm.collectionVariables.set('challengeCategory', list[0].category || 'mood');",
                  "    console.log('Captured challengeId=' + list[0].id + ' category=' + list[0].category);",
                  "  } else {",
                  "    // Fallback to a known seeded default so later requests still have a valid id",
                  "    pm.collectionVariables.set('challengeId', 'mood-marathon-weekly');",
                  "    pm.collectionVariables.set('challengeCategory', 'mood');",
                  "    console.log('No active challenges returned; falling back to default seeded challenge id');",
                  "  }",
                  "  if (list.length > 1) {",
                  "    pm.collectionVariables.set('secondChallengeId', list[1].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /challenges/{{challengeId}} - Get challenge by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/challenges/{{challengeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "challenges", "{{challengeId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Get challenge by id returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const data = body.data || body;",
                  "  pm.test('Challenge object has expected shape', () => {",
                  "    pm.expect(data.challenge).to.be.an('object');",
                  "    pm.expect(data.challenge.id).to.eql(pm.collectionVariables.get('challengeId'));",
                  "    pm.expect(data.challenge).to.have.property('goal');",
                  "    pm.expect(data.challenge).to.have.property('members');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /challenges/<unknown-id> - 404 for unknown challenge",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
