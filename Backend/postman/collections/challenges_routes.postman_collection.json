    {
      "name": "6. Not Executed For Safety (Reference Only)",
      "description": "Requests in this folder are intentionally NOT run in the live audit. The four default challenges seeded on this backend (mood-marathon-weekly, meditation-masters, journal-journey, streak-warriors) are shared, production, cross-user community challenges - their members[] list, team_size and current_progress are visible to and shared with real other app users. join/contribute happy paths perform a real Firestore write against that shared document (adding a member, incrementing progress, and potentially flipping a shared challenge's completed=true), and leave() unconditionally calls challenge_ref.update() on the same shared doc even as a no-op. These are kept here as reference for a human to run deliberately against a disposable/test challenge id.",
      "item": [
        {
          "name": "[SKIPPED] POST /challenges/{{challengeId}}/join - Join real shared community challenge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/challenges/{{challengeId}}/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "challenges", "{{challengeId}}", "join"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"E2E Challenges Tester\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Not executed in the automated run. Would add this test user to the",
                  "// members[] array of a real, shared production challenge (visible to",
                  "// real other users) and increment team_size. Skipped for safety."
                ]
              }
            }
          ]
        },
        {
          "name": "[SKIPPED] POST /challenges/{{challengeId}}/join - Join again (already joined)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/challenges/{{challengeId}}/join",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "challenges", "{{challengeId}}", "join"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"E2E Challenges Tester\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Depends on the real join above having already run. Would assert 400",
                  "// 'Already joined this challenge'. Skipped for safety (depends on a",
                  "// skipped request)."
                ]
              }
            }
          ]
        },
        {
          "name": "[SKIPPED] POST /challenges/{{challengeId}}/contribute - Valid contribution to real shared challenge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/challenges/{{challengeId}}/contribute",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "challenges", "{{challengeId}}", "contribute"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"{{challengeCategory}}\",\n  \"amount\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
