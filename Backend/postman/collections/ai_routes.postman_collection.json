{
  "info": {
    "name": "Lugn & Trygg - AI Routes API (Story & Forecast)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "d3f6a1b2-8c4e-4a7d-9f21-5e6b8c1a2f70",
    "description": "E2E audit collection for src/routes/ai_routes.py: POST /api/v1/ai/story, POST /api/v1/ai/forecast, GET /api/v1/ai/stories, GET /api/v1/ai/forecasts. Uses a dedicated e2e-ai_routes test account, chains the JWT via collection variables, and covers success + negative paths (no auth, invalid body)."
  },
  "variable": [
    { "key": "baseUrl", "value": "https://lugn-trygg-backend.onrender.com" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "testPassword", "value": "AuditP@ss2026x!" },
    { "key": "testUuid", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate a unique suffix for this run if not already set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "if (!pm.collectionVariables.get('testEmail')) {",
          "  pm.collectionVariables.set('testEmail', 'e2e-ai_routes-' + pm.collectionVariables.get('testUuid') + '@test.lugntrygg.se');",
          "}",
          "// Auto-inject Authorization header if accessToken is set (skip for noauth requests)",
          "const isNoAuth = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (pm.collectionVariables.get('accessToken') && !isNoAuth) {",
          "  pm.request.headers.upsert({",
          "    key: 'Authorization',",
          "    value: 'Bearer ' + pm.collectionVariables.get('accessToken'),",
          "    type: 'text'",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Auth Setup",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "register" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"E2E AI Routes Tester\",\n  \"accept_terms\": true,\n  \"accept_privacy\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "// 201 = created, 409 = already exists (re-run), 429 = shared rate limit across concurrent audit agents",
                  "pm.test('Register returns 201, 409 or 429', () => {",
                  "  pm.expect([201, 409, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 201) {",
                  "  console.log('Registered new user ' + pm.collectionVariables.get('testEmail'));",
                  "} else if (status === 409) {",
                  "  console.log('User already existed, proceeding to login');",
                  "} else if (status === 429) {",
                  "  console.log('Rate limited on register, will rely on login (may fail if user was never created)');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Test User",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "auth", "login" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "",
                  "pm.test('Login returns 200 (or 429 if rate limited)', () => {",
                  "  pm.expect([200, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  const body = pm.response.json();",
                  "  const responseData = body.data || body;",
                  "  pm.collectionVariables.set('accessToken', responseData.accessToken || '');",
                  "  pm.collectionVariables.set('userId', responseData.userId || (responseData.user && responseData.user.id) || '');",
                  "  console.log('Login OK, userId=' + pm.collectionVariables.get('userId'));",
                  "",
                  "  pm.test('AccessToken is set', () => {",
                  "    pm.expect(pm.collectionVariables.get('accessToken')).to.not.be.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. AI - Story Generation",
      "item": [
        {
          "name": "POST /ai/story - Generate story (sv locale)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/story",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "v1", "ai", "story" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locale\": \"sv\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const responseData = body.data || body;",
                  "",
                  "// 200 = success, 403 = account not on premium/trial plan (valid gating, not a bug),",
                  "// 429 = shared rate limit. A brand new account should get a 14-day trial so 200 is expected.",
                  "pm.test('Story returns 200 or 403 (premium gate) or 429', () => {",
                  "  pm.expect([200, 403, 429]).to.include(status);",
                  "});",
                  "",
                  "if (status === 200) {",
                  "  pm.test('Story response has expected fields', () => {",
                  "    pm.expect(responseData.story).to.be.a('string');",
                  "    pm.expect(responseData.story.length).to.be.above(0);",
                  "    pm.expect(responseData.locale).to.eql('sv');",
                  "    pm.expect(responseData).to.have.property('aiGenerated');",
                  "    pm.expect(responseData).to.have.property('generatedAt');",
                  "  });",
                  "} else if (status === 403) {",
                  "  pm.test('Premium-required error has expected shape', () => {",
                  "    pm.expect(body.error || body.errorCode).to.exist;",
                  "  });",
                  "}",
                  "console.log('Story (sv) status=' + status);"
                ]
              }
            }
          ]
        },
