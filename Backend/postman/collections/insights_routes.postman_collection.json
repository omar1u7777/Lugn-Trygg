    { "key": "insightId", "value": "" },
    { "key": "insightId2", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate unique suffixes for this run if not already set",
          "if (!pm.collectionVariables.get('testUuid')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid', uuid.v4().substring(0, 8));",
          "}",
          "if (!pm.collectionVariables.get('testUuid2')) {",
          "  const uuid = require('uuid');",
          "  pm.collectionVariables.set('testUuid2', uuid.v4().substring(0, 8));",
          "}"
        ]
      }
    }
