    {
      "name": "1. Generate Insights",
      "item": [
        {
          "name": "POST /insights/generate/{{userId}} - Self (primary user)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/insights/generate/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "insights", "generate", "{{userId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "const body = pm.response.json();",
                  "const data = body.data || body;",
                  "",
                  "pm.test('Generate insights returns 200', () => {",
                  "  pm.expect(status).to.eql(200);",
                  "});",
                  "",
                  "pm.test('Response has generated_count and insights array', () => {",
                  "  pm.expect(data).to.have.property('generated_count');",
                  "  pm.expect(data).to.have.property('insights');",
                  "  pm.expect(data.insights).to.be.an('array');",
                  "});",
                  "",
                  "if (data.insights && data.insights.length > 0) {",
                  "  pm.collectionVariables.set('insightId', data.insights[0].insight_id);",
                  "  console.log('Captured insightId=' + data.insights[0].insight_id + ' type=' + data.insights[0].insight_type);",
                  "} else {",
                  "  console.log('No insights generated for a fresh user (unexpected - onboarding fallback should fire for <3 mood logs)');",
                  "}"
                ]
              }
            }
          ]
        },
