        {
          "name": "POST /insights/action/{{insightId}} - Malformed JSON body (expect graceful handling, not 500)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/insights/action/{{insightId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "insights", "action", "{{insightId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{ this is not valid json "
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.code;",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) { /* non-JSON response */ }",
                  "console.log('Malformed body status=' + status + ' body=' + JSON.stringify(body));",
                  "",
                  "pm.test('Malformed JSON body does not crash the server (no 500)', () => {",
                  "  pm.expect(status).to.not.eql(500);",
                  "});",
                  "",
                  "if (status === 500) {",
                  "  console.log('BUG SUSPECT: request.get_json() raises a werkzeug BadRequest when the body is not valid JSON. ',",
                  "    'insight_action_taken() only has a bare except Exception around the whole handler, so that BadRequest is caught ',",
                  "    'and converted into APIResponse.error(\\'Failed to record action\\') with the DEFAULT status_code=500, instead of a 400. ',",
                  "    'Same class of bug likely affects any other route calling request.get_json() without silent=True inside a generic try/except.');",
                  "}"
                ]
              }
            }
          ]
        },
